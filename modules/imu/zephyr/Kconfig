config ASR_IMU
	bool "ASR IMU driver"
	default y
	depends on SENSOR
	help
	  Driver helpers for the project's IMU sensor. Provides device readiness
	  validation and single-sample reads.

config ASR_AHRS
	bool "ASR AHRS fusion"
	default y
	depends on ASR_IMU
	help
	  AHRS fusion helpers built on top of the IMU sample cache.

config ASR_IMU_THREAD
	bool "IMU read/print background thread"
	default n
	depends on ASR_IMU
	help
	  Spawns a background thread that periodically reads and logs IMU samples.
	  Thread timing is configured with the options below.

config ASR_IMU_STARTUP_DELAY_MS
	int "IMU thread startup delay in milliseconds"
	default 500
	depends on ASR_IMU_THREAD
	help
	  Delay before validating the IMU device and creating the IMU logging
	  thread.

config ASR_IMU_PERIOD_MS
	int "IMU sampling period in milliseconds"
	default 1000
	depends on ASR_IMU_THREAD
	help
	  Delay between IMU fetch and AHRS update iterations. Logging is throttled
	  independently.

config ASR_IMU_LOG_INTERVAL_MS
	int "IMU log interval in milliseconds"
	default 1000
	depends on ASR_IMU
	help
	  Minimum delay between IMU sample log output lines. This only affects
	  serial logging; sampling and AHRS update timing use ASR_IMU_PERIOD_MS.
