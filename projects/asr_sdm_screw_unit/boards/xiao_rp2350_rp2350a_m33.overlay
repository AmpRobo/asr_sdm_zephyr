/*
 * SPDX-License-Identifier: Apache-2.0
 * ICM-45686 sensor devicetree configuration
 * for Seeed XIAO RP2350 development board
 *
 * Hardware wiring:
 *   ICM-45686    XIAO RP2350
 *   ---------    -----------
 *   SPC (SCK)    D8  (GP2)
 *   SDI (MOSI)   D10 (GP3)
 *   SDO (MISO)   D9  (GP4)
 *   CS           D3  (GP5)
 *   VDD          3.3V
 *   GND          GND
 */

#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/sensor/icm45686.h>

/* USB CDC ACM device (console TX + interface module RX) */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		/* Default Zephyr CDC ACM UART TX FIFO is 1024 bytes. */
		tx-fifo-size = <2048>;
	};
};

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
	};

	aliases {
		asr-imu = &icm45686;
		asr-barometer = &hp206f;
	};
};

/*
 * Onboard user LED: gpio-leds (led0) and pwm-leds (pwm_led0) both use GP25
 * (PWM slice 4 channel B). If gpio-leds stays enabled, the pin stays GPIO and
 * PWM dimming never works — disable gpio-leds when using pwm_led0.
 */
&{/leds} {
	status = "disabled";
};

&{/pwm_leds} {
	status = "okay";
};

&uart0 {
	/* UART0 连接 BCAN-S01，模块默认 TTL 串口参数为 115200 8N1。 */
	current-speed = <115200>;
	status = "okay";
};

&uart1 {
	current-speed = <57600>;
	status = "okay";

	dynamixel0: dynamixel0 {
		compatible = "asr,dynamixel-rs485";
		status = "okay";
		dir-gpios = <&xiao_d 2 GPIO_ACTIVE_HIGH>; /* D2 = GP28 */
		servo-id = <1>;
		reply-timeout-us = <20000>;
		turnaround-delay-us = <2000>;
	};
};
&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_pullup_default>;
	pinctrl-names = "default";

	hp206f: pressure-sensor@76 {
		/* HP206F 压力/温度命令与 Zephyr HP206C driver 兼容。 */
		compatible = "hoperf,hp206c";
		reg = <0x76>;
		status = "okay";
	};
};

/* D4/GP6 预留给漏水传感器，避免 I2C1 占用 D4/D5。 */
&i2c1 {
	status = "disabled";
};

&xiao_spi {
	status = "okay";
	cs-gpios = <&xiao_d 3 GPIO_ACTIVE_LOW>;  /* D3 = GP5 */

	icm45686: icm45686@0 {
		compatible = "invensense,icm45686";
		reg = <0>;
		spi-max-frequency = <24000000>;  /* 24 MHz */

		/* Accelerometer configuration */
		accel-pwr-mode = <ICM45686_DT_ACCEL_LN>;      /* Low-noise mode */
		accel-fs = <ICM45686_DT_ACCEL_FS_16>;         /* ±16g */
		accel-odr = <ICM45686_DT_ACCEL_ODR_800>;      /* 800 Hz */

		/* Gyroscope configuration */
		gyro-pwr-mode = <ICM45686_DT_GYRO_LN>;        /* Low-noise mode */
		gyro-fs = <ICM45686_DT_GYRO_FS_500>;          /* ±500 dps */
		gyro-odr = <ICM45686_DT_GYRO_ODR_200>;        /* 200 Hz */
	};
};

/* 板载无 I2C 上拉，HP206F 使用 RP2350 内部上拉（~50kΩ）。 */
&pinctrl {
	i2c0_pullup_default: i2c0_pullup_default {
		group1 {
			pinmux = <I2C0_SDA_P16>;
			input-enable;
			bias-pull-up;
		};

		group2 {
			pinmux = <I2C0_SCL_P17>;
			input-enable;
			bias-pull-up;
		};
	};
};
